<nav class="navbar normal-navbar">

    <div class="container-fluid normal-navbar-inner">

        <a href="/app" class="normal-brand">
            VIORA
        </a>


        <form
            class="d-flex normal-search"
            role="search"
            action="/app/search"
        >

            <input
                class="form-control search-inp"
                name="query"
                type="search"
                placeholder="Search product.."
            >

        <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
        </button>

        </form>


        <div class="normal-user-links">

            <% if(!newUser){ %>

                <a
                    class="normal-nav-link"
                    href="/app/signup"
                >
                    Sign-Up
                </a>

                <a
                    class="normal-nav-link"
                    href="/app/login"
                >
                    Log-In
                </a>

            <% } %>


            <% if(newUser){ %>

                <a
                    class="normal-nav-link"
                    href="/app/cart"
                >
                    <i class="fa-solid fa-bag-shopping"></i>
                    Cart
                </a>

                <a
                    class="normal-nav-link"
                    href="/app/logout"
                >
                    Log Out
                </a>

            <% } %>

        </div>

    </div>

</nav>