<%- layout("/layouts/boilerplate.ejs") %>

<section class="viora-detail-page">

    <div class="viora-detail-container">

        <!-- LEFT : PRODUCT IMAGE -->
        <div class="viora-detail-image-section">

            <div class="viora-detail-image-wrap">

                <img
                    src="<%= product.images[0] %>"
                    alt="<%= product.name %>"
                    class="viora-detail-image"
                >

            </div>

            <p class="viora-image-caption">
                VIORA FINE JEWELS
            </p>

        </div>


        <!-- RIGHT : PRODUCT INFORMATION -->
        <div class="viora-detail-info">

            <p class="viora-detail-eyebrow">
                THE VIORA COLLECTION
            </p>

            <h1 class="viora-detail-title">
                <%= product.name %>
            </h1>

            <div class="viora-detail-line"></div>


            <p class="viora-detail-price">
                $<%= product.price.toFixed(2) %>
            </p>


            <div class="viora-detail-meta">

                <div class="viora-meta-row">
                    <span>BRAND</span>
                    <strong><%= product.brand %></strong>
                </div>

                <div class="viora-meta-row">
                    <span>AVAILABILITY</span>
                    <strong>IN STOCK</strong>
                </div>

            </div>


            <div class="viora-detail-description">

                <p>
                    <%= product.description %>
                </p>

            </div>


            <div class="viora-detail-actions">

                <a
                    href="/app/<%= product._id %>/purchase"
                    class="viora-purchase-btn"
                >

                    <span>PURCHASE</span>

                    <span class="viora-purchase-arrow">
                        →
                    </span>

                </a>

            </div>


            <p class="viora-detail-note">
                Crafted for moments that deserve to be remembered.
            </p>

        </div>

    </div>

</section>