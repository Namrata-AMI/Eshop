<%- layout("/layouts/boilerplate.ejs") %>

<section class="viora-products-page">

    <div class="viora-products-container">

        <!-- =========================
             COLLECTION HEADER
        ========================== -->

        <div class="viora-products-header">

            <p class="viora-eyebrow">
                VIORA COLLECTION
            </p>

            <h1>
                <%= collection %>
            </h1>

            <div class="viora-header-line"></div>

        </div>


        <!-- =========================
             PRODUCTS
        ========================== -->

        <div class="viora-product-grid">

            <% products.forEach(product => { %>

                <div class="viora-product-card">

                    <!-- PRODUCT IMAGE -->

                    <a
                        href="/app/<%= product._id %>"
                        class="viora-product-image-link"
                    >

                        <div class="viora-product-image-box">

                            <img
                                src="<%= product.images[0] %>"
                                alt="<%= product.name %>"
                                loading="lazy"
                            >

                            <span class="viora-view-overlay">
                                VIEW DETAILS
                            </span>

                        </div>

                    </a>


                    <!-- PRODUCT CONTENT -->

                    <div class="viora-product-content">

                        <!-- NAME + PRICE -->

                        <div class="viora-product-heading">

                            <div>

                                <h2>
                                    <%= product.name %>
                                </h2>

                                <p class="viora-product-brand">
                                    <%= product.brand %>
                                </p>

                            </div>

                            <p class="viora-product-price">
                                ₹<%= product.price %>
                            </p>

                        </div>


                        <!-- DESCRIPTION -->

                        <p class="viora-product-description">
                            <%= product.description %>
                        </p>


                        <!-- ACTIONS -->

                        <div class="viora-product-actions">

                            <button
                                type="button"
                                class="viora-add-cart"
                            >
                                <i class="fa-solid fa-bag-shopping"></i>
                                ADD TO CART
                            </button>

                            <a
                                href="/app/<%= product._id %>"
                                class="viora-view-product"
                            >
                                VIEW
                                <span>→</span>
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    </div>

</section>