<%- layout("/layouts/boilerplate.ejs") %>

<section class="viora-concierge">

    <!-- HERO -->
    <section class="viora-concierge-hero">

        <div class="viora-concierge-hero-text">

            <p>VIORA CONCIERGE</p>

            <h1>
                A More Personal<br>
                Way To Choose
            </h1>

            <p class="viora-concierge-intro">
                From choosing the perfect piece to finding a meaningful
                gift, our concierge service is here to make every
                jewelry decision feel effortless.
            </p>

            <a href="#concierge-services" class="viora-concierge-button">
                DISCOVER THE SERVICE
                <span>↓</span>
            </a>

        </div>

        <div class="viora-concierge-hero-image">
            <img
                src="/assets/img11.png"
                alt="Luxury jewelry">
        </div>

    </section>


    <!-- INTRO -->
    <section class="viora-concierge-intro-section">

        <div class="viora-concierge-number">
           
        </div>

        <div class="viora-concierge-content">

            <div class="viora-concierge-image">
                <img
                    src="/assets/img1.png",
                    alt="Jewelry collection">
            </div>

            <div>

                <p class="viora-concierge-label">
                    THE VIORA EXPERIENCE
                </p>

                <h2>
                    Jewelry chosen<br>
                    with intention.
                </h2>

                <p>
                    Sometimes the right piece is about more than
                    appearance. It can mark a celebration, express
                    something personal, or simply feel like you.
                </p>

                <p>
                    Our concierge service offers thoughtful guidance
                    to help you discover pieces that suit your style,
                    occasion, and story.
                </p>

            </div>

        </div>

    </section>


    <!-- SERVICES -->
    <section id="concierge-services" class="viora-concierge-services">

        <div class="viora-concierge-services-heading">

            <p>HOW WE CAN HELP</p>

            <h2>
                Your jewelry,<br>
                your way.
            </h2>

        </div>


        <div class="viora-concierge-grid">

            <div class="viora-concierge-card">
                <span>01</span>

                <h3>Find Your Piece</h3>

                <p>
                    Looking for something specific?
                    Tell us what you have in mind and
                    we'll help you explore the possibilities.
                </p>
            </div>


            <div class="viora-concierge-card">
                <span>02</span>

                <h3>Gift Guidance</h3>

                <p>
                    Choosing jewelry for someone special?
                    We can help you find a thoughtful piece
                    for their style and occasion.
                </p>
            </div>


            <div class="viora-concierge-card">
                <span>03</span>

                <h3>Style Consultation</h3>

                <p>
                    Discover ways to build your collection,
                    layer pieces, and find jewelry that
                    feels naturally yours.
                </p>
            </div>


            <div class="viora-concierge-card">
                <span>04</span>

                <h3>Special Occasions</h3>

                <p>
                    From anniversaries to meaningful milestones,
                    let us help you find something worthy of
                    the moment.
                </p>
            </div>

        </div>

    </section>


    <!-- PROCESS -->
    <section class="viora-concierge-process">

        <div class="viora-concierge-process-heading">

            <p>THE PROCESS</p>

            <h2>
                Simple.<br>
                Personal.
            </h2>

        </div>


        <div class="viora-concierge-steps">

            <div>
                <span>01</span>

                <h3>Tell Us</h3>

                <p>
                    Share what you're looking for,
                    your preferences, or the occasion.
                </p>
            </div>


            <div>
                <span>02</span>

                <h3>We Curate</h3>

                <p>
                    We'll help narrow down pieces that
                    fit your style and requirements.
                </p>
            </div>


            <div>
                <span>03</span>

                <h3>Make It Yours</h3>

                <p>
                    Choose the piece that feels right
                    and make the moment your own.
                </p>
            </div>

        </div>

    </section>


    <!-- FINAL CTA -->
    <section class="viora-concierge-final">

        <p>START A CONVERSATION</p>

        <h2>
            Let us help you<br>
            find something special.
        </h2>

        <p>
            Have a question or looking for something particular?
            We'd love to help.
        </p>

        <a href="/app/contact" class="viora-concierge-button">
            CONTACT CONCIERGE
            <span>→</span>
        </a>

    </section>

</section>