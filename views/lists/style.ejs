<%- layout("/layouts/boilerplate.ejs") %>

<section class="viora-style-page">

    <!-- HERO -->
    <div class="viora-style-hero">
        <p class="viora-style-eyebrow">THE VIORA EDIT</p>

        <h1>STYLE</h1>

        <p class="viora-style-intro">
            Discover thoughtful ways to wear, layer and care for
            your favorite VIORA pieces.
        </p>
    </div>


    <!-- STYLE CATEGORIES -->
    <section class="viora-style-categories">

        <div class="viora-style-section-heading">
            <p>EXPLORE</p>
            <h2>Discover Your Style</h2>
        </div>

        <div class="viora-style-grid">

            <a href="#" class="viora-style-card">
                <div class="viora-style-image">
                    <img src="/assets/every.png" alt="Everyday Jewelry">
                </div>

                <div class="viora-style-card-info">
                    <span>01</span>
                    <h3>Everyday Elegance</h3>
                    <p>Simple pieces for effortless everyday looks.</p>
                    <strong>EXPLORE →</strong>
                </div>
            </a>


            <a href="#" class="viora-style-card">
                <div class="viora-style-image">
                    <img src="/assets/occassion.png" alt="Occasion Jewelry">
                </div>

                <div class="viora-style-card-info">
                    <span>02</span>
                    <h3>For The Occasion</h3>
                    <p>Jewelry designed to complete memorable moments.</p>
                    <strong>EXPLORE →</strong>
                </div>
            </a>


            <a href="#" class="viora-style-card">
                <div class="viora-style-image">
                    <img src="/assets/layer.png" alt="Layering Jewelry">
                </div>

                <div class="viora-style-card-info">
                    <span>03</span>
                    <h3>Layer & Stack</h3>
                    <p>Combine pieces to create your own signature look.</p>
                    <strong>EXPLORE →</strong>
                </div>
            </a>

        </div>

    </section>


    <!-- HOW TO STYLE -->
    <section class="viora-style-feature">

        <div class="viora-style-feature-image">
            <img src="/assets/ocassion.png" alt="VIORA Style Guide">
        </div>

        <div class="viora-style-feature-content">

            <p>STYLE GUIDE</p>

            <h2>How To Style<br>Your Jewelry</h2>

            <div class="viora-style-line"></div>

            <p>
                From delicate everyday layers to statement pieces,
                discover simple ways to make your jewelry feel
                uniquely yours.
            </p>

            <a href="#" class="viora-style-button">
                READ THE GUIDE
                <span>→</span>
            </a>

        </div>

    </section>


    <!-- JEWELRY CARE -->
    <section class="viora-care-section">

        <div class="viora-style-section-heading">
            <p>THE VIORA GUIDE</p>
            <h2>Care For Your Jewelry</h2>
        </div>

        <div class="viora-care-grid">

            <div class="viora-care-item">
                <span>01</span>
                <h3>Keep It Clean</h3>
                <p>
                    Learn simple ways to keep your jewelry
                    looking polished and beautiful.
                </p>
            </div>

            <div class="viora-care-item">
                <span>02</span>
                <h3>Store With Care</h3>
                <p>
                    Protect your pieces from scratches,
                    moisture and everyday wear.
                </p>
            </div>

            <div class="viora-care-item">
                <span>03</span>
                <h3>Wear With Intention</h3>
                <p>
                    Small habits can help preserve the beauty
                    of your favorite pieces.
                </p>
            </div>

        </div>

    </section>

</section>