<%- layout("/layouts/boilerplate.ejs") %>

<section class="viora-style-guide">

    <!-- HERO -->
    <div class="viora-guide-hero">

        <p>STYLE GUIDE</p>

        <h1>
            How To Style<br>
            Your Jewelry
        </h1>

        <p class="viora-guide-intro">
            From delicate everyday layers to statement pieces,
            discover simple ways to make your jewelry feel
            uniquely yours.
        </p>

    </div>


    <!-- 01 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            01
        </div>

        <div class="viora-guide-content">

            <h2>Start With The Everyday</h2>

            <p>
                Begin with delicate pieces that complement your
                daily look. A fine chain, small pendant, or simple
                pair of earrings can add a subtle touch of elegance
                without feeling overdone.
            </p>

        </div>

    </section>


    <!-- 02 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            02
        </div>

        <div class="viora-guide-content">

            <h2>Layer With Intention</h2>

            <p>
                Combine different lengths, textures, and shapes
                to create a layered look that feels personal.
                Start with one simple piece and gradually add
                more until the balance feels right.
            </p>

        </div>

    </section>


    <!-- 03 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            03
        </div>

        <div class="viora-guide-content">

            <h2>Mix & Match</h2>

            <p>
                Don't be afraid to combine different jewelry styles.
                Pair minimal pieces with a statement ring or mix
                classic designs with contemporary shapes to create
                contrast.
            </p>

        </div>

    </section>


    <!-- 04 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            04
        </div>

        <div class="viora-guide-content">

            <h2>Let One Piece Lead</h2>

            <p>
                For special occasions, choose one statement piece
                as the focus of your look. Keep the rest of your
                jewelry understated so the main piece naturally
                stands out.
            </p>

        </div>

    </section>


    <!-- 05 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            05
        </div>

        <div class="viora-guide-content">

            <h2>Match The Moment</h2>

            <p>
                Choose jewelry according to the occasion.
                Keep everyday styling refined and effortless,
                while celebrations and evening events can call
                for more sparkle and statement pieces.
            </p>

        </div>

    </section>


    <!-- 06 -->
    <section class="viora-guide-section">

        <div class="viora-guide-number">
            06
        </div>

        <div class="viora-guide-content">

            <h2>Make It Yours</h2>

            <p>
                The best jewelry reflects your personal style.
                Whether you prefer delicate layers or bold pieces,
                wear what feels natural to you and let your jewelry
                become part of your signature look.
            </p>

        </div>

    </section>


    <!-- JEWELRY CARE -->

    <section class="viora-guide-care">

        <div class="viora-guide-care-heading">

            <p>THE VIORA GUIDE</p>

            <h2>Care For Your Jewelry</h2>

        </div>


        <div class="viora-guide-care-grid">

            <div class="viora-guide-care-item">

                <span>01</span>

                <h3>Keep It Clean</h3>

                <p>
                    Gently clean your pieces with a soft,
                    dry cloth to maintain their shine.
                </p>

            </div>


            <div class="viora-guide-care-item">

                <span>02</span>

                <h3>Store With Care</h3>

                <p>
                    Keep jewelry in a dry, protected place
                    and separate individual pieces to avoid
                    scratches and tangling.
                </p>

            </div>


            <div class="viora-guide-care-item">

                <span>03</span>

                <h3>Wear With Intention</h3>

                <p>
                    Remove your jewelry before swimming,
                    bathing, exercising, or applying perfumes
                    and lotions.
                </p>

            </div>

        </div>

    </section>


    <!-- FINAL CTA -->

    <section class="viora-guide-final">

        <p>VIORA</p>

        <h2>
            Style That<br>
            Feels Like You
        </h2>

        <p>
            From everyday essentials to statement pieces,
            discover jewelry that completes your look and
            becomes part of your story.
        </p>

        <a href="/app/products" class="viora-guide-button">
            EXPLORE COLLECTION
            <span>→</span>
        </a>

    </section>

</section>